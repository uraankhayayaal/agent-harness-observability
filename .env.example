# === HTTP (backend) ===
# Адрес HTTP-сервера бэкенда (host:port)
HTTP_ADDR=:8080
# Публикуемый порт backend в docker-compose (host:container)
HTTP_PORT=8080
# Базовый путь API (endpoint: {API_BASE_PATH}/runs/{run_id}/trajectory)
API_BASE_PATH=/v1

# === Kafka ===
# Брокеры через запятую
# Для запуска на хосте: localhost:9092; в docker-compose переопределяется на kafka:29092
KAFKA_BROKERS=localhost:9092
# Топик событий шагов
KAFKA_TOPIC=agent-harness-metrics
# Consumer Group ID
KAFKA_GROUP_ID=agent-metrics-analyzer
# Начальное смещение: last | first
KAFKA_START_OFFSET=last
# Настройки чтения (батчинг)
KAFKA_FETCH_MIN_BYTES=1024
KAFKA_FETCH_MAX_BYTES=52428800
KAFKA_MAX_WAIT_MS=500
KAFKA_SESSION_TIMEOUT_MS=30000
KAFKA_HEARTBEAT_INTERVAL_MS=10000
# Producer (для cmd/producer и харнеса)
KAFKA_ACKS=all
KAFKA_COMPRESSION=snappy
KAFKA_BATCH_SIZE=16384
KAFKA_LINGER_MS=10

# === PostgreSQL ===
# DSN бэкенда
POSTGRES_URL=postgres://harness_user:harness_password@localhost:5432/harness_db?sslmode=disable
# Креды и порт (docker-compose)
POSTGRES_USER=harness_user
POSTGRES_PASSWORD=harness_password
POSTGRES_DB=harness_db
POSTGRES_PORT=5432

# === Neo4j ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=harness_password
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# === Frontend (Vite) ===
FRONTEND_PORT=5173
# Публикуемый порт frontend (nginx, prod-сборка) в docker-compose
WEB_PORT=8081
# Цель прокси dev-сервера для API_BASE_PATH
VITE_API_PROXY_TARGET=http://localhost:8080
# Базовый путь API (должен совпадать с API_BASE_PATH)
VITE_API_BASE_PATH=/v1

# === Прочее ===
# debug | info
LOG_LEVEL=info
# UI Kafka
KAFDROP_PORT=9000
